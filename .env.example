# ============================================================
#  VortexBoost — environment variables
#
#  LOCAL:  copy this file to `.env` and fill in what you have.
#          `.env` is gitignored — never commit real keys.
#  RENDER: set these in the service's Environment tab
#          (or let render.yaml prompt you for the `sync: false` ones).
#
#  Everything below is optional for local development — the app boots
#  fine with an empty .env and runs in demo mode. It only becomes fully
#  operational once Simmwiz + CAMPay keys are filled in.
# ============================================================

# ------------------------------------------------------------
# CORE
# ------------------------------------------------------------

# Long random string used to sign login tokens.
# REQUIRED in production — the app refuses to boot without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The account that sees the Owner dashboard (deposits, provider cost,
# net margin) on the Wallet page.
OWNER_EMAIL=evaristusnuza@gmail.com

# ------------------------------------------------------------
# DATABASE
#
# Leave BOTH unset for local development -> SQLite file in the repo.
#
# On Render, pick ONE of the two options below (see README):
# ------------------------------------------------------------

# Option A — SQLite on a Render persistent disk (requires a PAID plan).
# Mount a disk at /var/data, then point DB_PATH at it:
# DB_PATH=/var/data/data.db

# Option B — PostgreSQL (survives on any plan, including free).
# Copy the "Internal Database URL" from your Render Postgres instance.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ------------------------------------------------------------
# SIMMWIZ  (upstream provider you resell from)
# Without these, orders are refused in production (customers are
# never charged) — or simulated in demo mode locally.
# ------------------------------------------------------------

# Usually ends in /api/v2 — no trailing slash.
SIMMWIZ_API_URL=
SIMMWIZ_API_KEY=

# ------------------------------------------------------------
# CAMPAY  (MTN MoMo / Orange Money / Crypto)
# Without these, the payment page refuses to take money.
# ------------------------------------------------------------

CAMPAY_BASE_URL=https://api.campayapp.com/v2
CAMPAY_API_KEY=
CAMPAY_SECRET=
CAMPAY_MERCHANT_ACCOUNT=

# ------------------------------------------------------------
# DEVELOPMENT ONLY — NEVER enable these in production.
# The app refuses to boot in production if ENABLE_TEST_DEPOSITS=1.
# ------------------------------------------------------------

# "1" = credit wallet deposits instantly without taking payment.
ENABLE_TEST_DEPOSITS=0

# "1" = accept orders and fake-complete them without contacting Simmwiz.
# On by default when NODE_ENV is not "production"; forced off in production
# unless you explicitly set it to 1. Do NOT charge real customers with it on.
ALLOW_DEMO_ORDERS=0

# How fast a simulated order "completes" (milliseconds).
DEMO_ORDER_MS=90000

# ------------------------------------------------------------
# OPTIONAL
# ------------------------------------------------------------

# Only needed if you host the frontend on a DIFFERENT domain than the
# API. Comma-separated allowlist; "*" allows everything.
# The frontend served by this app is same-origin and needs nothing here.
# CORS_ORIGIN=https://your-store.example

# Set automatically by Render. Locally, defaults to 3000.
# PORT=3000
